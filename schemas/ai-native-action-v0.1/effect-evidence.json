{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native:action:v0.1:effect-evidence",
  "title": "AI Native Action observation evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signer_key_id", "signature_alg", "digest", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile", "tenant", "task_id", "operation_id", "authorization_digest",
        "result_digest", "observation", "recorded_at"
      ],
      "properties": {
        "profile": {"const": "ai-native-action/effect-evidence/v0.1"},
        "tenant": {"$ref": "#/$defs/identifier"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "operation_id": {"$ref": "#/$defs/identifier"},
        "authorization_digest": {"$ref": "#/$defs/digest"},
        "result_digest": {"$ref": "#/$defs/digest"},
        "observation": {"enum": ["local_transaction", "remote_receipt_observed"]},
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{6}Z$"
        }
      }
    },
    "signer_key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
    "signature_alg": {"const": "Ed25519"},
    "digest": {"$ref": "#/$defs/digest"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
