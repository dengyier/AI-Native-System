{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atomic source-side conditional operation",
  "type": "object",
  "required": [
    "tenant",
    "operation_id",
    "action_instance_id",
    "action",
    "object_id",
    "from_state",
    "to_state",
    "requester",
    "approver",
    "executor",
    "expected_version",
    "release_digest",
    "request_hash",
    "source_conditions"
  ],
  "additionalProperties": false,
  "properties": {
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\s]"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\s]"
    },
    "action_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\s]"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\s]"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\s]"
    },
    "from_state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\s]"
    },
    "to_state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\s]"
    },
    "requester": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\s]"
    },
    "approver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\s]"
    },
    "executor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "[^\\s]"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "release_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_conditions": {
      "type": "object",
      "required": [
        "source",
        "targets",
        "guards"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "[^\\s]"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "type",
              "id",
              "record_type",
              "record_id",
              "from_state",
              "to_state",
              "expected_version"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "[^\\s]"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "[^\\s]"
              },
              "record_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "[^\\s]"
              },
              "record_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "[^\\s]"
              },
              "from_state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "[^\\s]"
              },
              "to_state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "[^\\s]"
              },
              "expected_version": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "[^\\s]"
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                ]
              }
            }
          }
        },
        "guards": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "type",
              "id",
              "expected_version"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "[^\\s]"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "[^\\s]"
              },
              "expected_version": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "[^\\s]"
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
