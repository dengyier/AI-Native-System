{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-signed operation receipt",
  "type": "object",
  "required": [
    "payload",
    "signer_key_id",
    "signature_alg",
    "digest",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "payload": {
      "type": "object",
      "required": [
        "profile",
        "source",
        "tenant",
        "operation_id",
        "request_hash",
        "authorization_digest",
        "status",
        "recorded_at",
        "retain_until",
        "result",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "ai-native-action/source-receipt/v0.1"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "[^\\s]"
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "[^\\s]"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "[^\\s]"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorization_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "succeeded",
            "rejected",
            "not_found"
          ]
        },
        "recorded_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "retain_until": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "objects"
              ],
              "additionalProperties": false,
              "properties": {
                "objects": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "id",
                      "previous_version",
                      "version",
                      "state"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "pattern": "[^\\s]"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "pattern": "[^\\s]"
                      },
                      "previous_version": {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "[^\\s]"
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        ]
                      },
                      "version": {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "[^\\s]"
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        ]
                      },
                      "state": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "pattern": "[^\\s]"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "reason": {
          "enum": [
            null,
            "condition_mismatch",
            "operation_unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_found"
              }
            }
          },
          "then": {
            "properties": {
              "authorization_digest": {
                "type": "null"
              },
              "retain_until": {
                "type": "null"
              },
              "result": {
                "type": "null"
              },
              "reason": {
                "const": "operation_unknown"
              }
            }
          },
          "else": {
            "properties": {
              "authorization_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "retain_until": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "null"
              },
              "reason": {
                "const": "condition_mismatch"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "signer_key_id": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{64}$"
    },
    "signature_alg": {
      "const": "Ed25519"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
